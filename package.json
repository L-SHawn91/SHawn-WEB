{
  "name": "shawn-lab-digital",
  "version": "5.0.0",
  "private": true,
  "description": "SHawn Lab Digital Research Ecosystem - Bio-Informatics & Market Intelligence",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "pnpm --dir apps/desktop-tauri typecheck",
    "build:web": "pnpm --dir apps/desktop-tauri build:web",
    "desktop:dev": "pnpm --dir apps/desktop-tauri dev",
    "desktop:build": "pnpm --dir apps/desktop-tauri build",
    "desktop:lint": "pnpm --dir apps/desktop-tauri lint",
    "sync": "python3 ../sync_to_web.py",
    "reports:sync-index": "node scripts/sync-reports-index.mjs",
    "sync:shide-blog": "node scripts/sync-shide-blog-packages.mjs",
    "sync:shide-blog:dry": "node scripts/sync-shide-blog-packages.mjs --dry-run",
    "publish:web": "node scripts/publish-web.mjs",
    "publish:web:go": "node scripts/publish-web.mjs --publish",
    "test:shide-blog-sync": "node scripts/test-shide-blog-sync.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:search:intent": "node --experimental-strip-types scripts/test-classify-intent.mjs",
    "test:search:regression": "node scripts/test-search.mjs --regression --fail-on-regression",
    "check:i18n": "node scripts/enforce-i18n.mjs",
    "check:forbidden-terms": "node scripts/enforce-forbidden-terms.mjs",
    "jcr:build-index": "node scripts/build-jcr-index.mjs",
    "search:build-ontology": "node scripts/build-search-ontology.mjs",
    "check:search-ontology": "node scripts/check-search-ontology.mjs",
    "check:public-safety": "node scripts/public-safety-scan.mjs",
    "test:invest-public-safety": "node scripts/test-invest-public-safety.mjs",
    "sync:wordpress-public": "node scripts/sync-wordpress-public-posts.mjs",
    "sync:wordpress-public:dry": "node scripts/sync-wordpress-public-posts.mjs --dry-run",
    "sync:public-content": "node scripts/sync-public-content.mjs",
    "test:wordpress-public-sync": "node scripts/test-wordpress-public-sync.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
