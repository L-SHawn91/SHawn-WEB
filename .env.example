JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USER_IDS=7727358623
# Bio search — server-side only, never exposed to browser
# NCBI: 3→10 req/sec + real abstracts via efetch
NCBI_API_KEY=
# Semantic Scholar: removes anonymous rate limit
S2_API_KEY=
GCP_BRAIN_URL=https://shawn-brain-1009266651998.asia-northeast3.run.app
# Optional: set desktop/local gateway API base (e.g. http://127.0.0.1:8787)
NEXT_PUBLIC_SHAWNBRAIN_API_BASE_URL=
# Optional: if set, SHawn-WEB /api/invest/snapshot proxies to SHawn-INV snapshot endpoint
SHAWN_INV_SNAPSHOT_URL=
# Optional privacy-conscious measurement (Vercel Analytics remains independent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Legacy name supported for existing deployments; prefer the variable above.
NEXT_PUBLIC_GOOGLE_ANALYTICS=
# Reader update delivery: HTTPS endpoint owned by the operator. Keep the bearer token server-only.
READER_UPDATES_WEBHOOK_URL=
READER_UPDATES_WEBHOOK_BEARER_TOKEN=
