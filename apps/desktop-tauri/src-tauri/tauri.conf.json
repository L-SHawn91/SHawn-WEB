{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHawnDesktopTauri",
  "version": "0.1.0",
  "identifier": "com.shawnlab.desktop",
  "build": {
    "beforeBuildCommand": "pnpm run build:web",
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SHawn Desktop",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
